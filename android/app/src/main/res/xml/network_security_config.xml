<?xml version="1.0" encoding="utf-8"?>
<!-- اجازه‌ی ws:// و http:// (سرور ویس روی IP:PORT بدون TLS) — بدون این، اندروید ۹+ اتصال را رد می‌کند -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
